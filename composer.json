{
  "name": "bojaghi/rest-routes",
  "description": "워드프레스 REST API 사용을 위한 `register_rest_route` 함수를 좀 더 편리하게 등록 관리해 주는 패키지입니다.",
  "homepage": "https://github.com/bojaghi/rest-routes",
  "type": "library",
  "license": "GPL-2.0-or-later",
  "autoload": {
  },
  "autoload-dev": {
  },
  "authors": [
    {
      "name": "changwoo",
      "email": "ep6tri@hotmail.com"
    }
  ],
  "require": {
    "php": ">=8.3",
    "bojaghi/contract": "^2",
    "bojaghi/helper": "^2"
  },
  "require-dev": {
    "phpunit/phpunit": "^9",
    "bojaghi/dictionary": "^1.0",
    "wp-coding-standards/wpcs": "^3.0",
    "yoast/phpunit-polyfills": "^3.0",
    "alleyinteractive/composer-wordpress-autoloader": "^1.3"
  },
  "scripts": {
    "phpcs": "phpcs",
    "phpcbf": "phpcbf"
  },
  "version": "2.0.0",
  "config": {
    "allow-plugins": {
      "alleyinteractive/composer-wordpress-autoloader": true,
      "dealerdirect/phpcodesniffer-composer-installer": true
    }
  },
  "extra": {
    "wordpress-autoloader": {
      "autoload": {
        "Bojaghi\\Rest_Routes\\": "inc/"
      },
      "autoload-dev": {
        "Bojaghi\\Rest_Routes\\": "tests/"
      },
      "inject": true
    }
  }
}
